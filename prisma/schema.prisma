// prisma/schema.prisma
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"  
}

datasource db {
  provider  = "postgresql"  
}

model User {
  id               String        @id @unique  // This will be the Supabase Auth user UUID
  name             String?
  email            String        @unique
  
  colorScheme      String        @default("theme-cyber")
  themePreference  String        @default("dark")

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  memberships OrganizationMember[]
  invites     OrganizationInvite[]
}

model Subscription {
  stripeSubscriptionId String   @id @unique
  interval             String
  status               String
  planId               String
  currentPeriodStart   Int
  currentPeriodEnd     Int
  periodEndReminderSent Boolean @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId       String?       @unique

  @@index([status])
  @@index([planId])
  @@index([createdAt(sort: Desc)])
  @@index([organizationId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Organization {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(20)
  slug        String   @unique

  // Billing (Moved from User)
  stripeCustomerId             String?   @unique
  isPrimary                    Boolean   @default(false)
  credits                      Int       @default(0)
  creditsReminderThresholdSent Boolean   @default(false)
  lastFreeRefillAt             DateTime  @default(now())
  // Tracks a one-time (non-recurring) plan purchase, e.g. Starter, which is
  // sold via a one-time Stripe Checkout payment and therefore never creates a
  // Subscription row. Set by the Stripe webhook when a one-time payment for a
  // paid plan succeeds. Independent of `subscription` -- an org can have
  // either, both (e.g. later upgrading to a recurring plan), or neither.
  oneTimePlanId                 String?

  subscription Subscription?

  deletedAt   DateTime? // Soft Delete
  
  members     OrganizationMember[]
  workspaces  Workspace[]
  invites     OrganizationInvite[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  // Owner-granted permission for an ADMIN to buy/change subscriptions and
  // manage billing (billingRouter's createSubscription/renewSubscription/
  // createCustomerPortal). Irrelevant for OWNER (always full access) and
  // MEMBER (billing is admin-tier-and-up regardless of this flag). Only the
  // OWNER can set this -- see organization.ts's setMemberBillingAccess.
  canManageBilling Boolean        @default(false)
  
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Explicit per-workspace access grants for this membership (OWNER ignores this: always full access)
  workspaceAccess WorkspaceMember[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

model Workspace {
  id             String       @id @default(cuid())
  name           String       @db.VarChar(20)
  slug           String
  organizationId String
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Members explicitly granted access to this workspace (OWNER is implicit, not tracked here)
  members        WorkspaceMember[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// Join table controlling which organization members can see/use which workspaces.
// A row here means "this member has access to this workspace". The OWNER role is
// intentionally never represented here -- owners always have implicit access to
// every workspace in their organization (enforced in application code).
model WorkspaceMember {
  id                    String   @id @default(cuid())
  workspaceId           String
  organizationMemberId  String

  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizationMember    OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())

  @@unique([workspaceId, organizationMemberId])
  @@index([organizationMemberId])
  @@index([workspaceId])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  // Carries the OWNER's canManageBilling grant through to acceptance, when
  // the invited role is ADMIN -- see OrganizationMember.canManageBilling.
  canManageBilling Boolean        @default(false)
  status         InviteStatus     @default(PENDING)
  token          String       @unique
  expiresAt      DateTime

  // Workspaces the invited member will be granted access to once they accept.
  // Chosen by the inviter at invite time (defaults to every workspace the inviter can access).
  workspaceIds   String[]     @default([])

  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id])
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([email])
  @@index([organizationId])
}
